        <date_format_timezone>Europe/Lisbon</date_format_timezone>
        <lenient_string_to_number>N</lenient_string_to_number>
      </value-meta>
      <value-meta>
        <type>BigNumber</type>
        <storagetype>normal</storagetype>
        <name>global_sales</name>
        <length>38</length>
        <precision>2</precision>
